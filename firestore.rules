rules_version = '2';

// Reglas de seguridad de la base de datos.
// - Los clientes (sin cuenta) solo pueden: ver el menú, crear su pedido y ver el estado de su pedido.
// - Solo el dueño (con su correo y contraseña) puede cambiar productos, ajustes y estados de pedidos.
service cloud.firestore {
  match /databases/{database}/documents {

    // CAMBIA ESTE CORREO por el correo de tu usuario de dueño (puedes poner varios separados por coma).
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['iawork200827@gmail.com'];
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['customer', 'table', 'note', 'items', 'total', 'status', 'createdAt', 'code'])
        && d.status == 'pendiente'
        && d.createdAt == request.time
        && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 60
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0
        && d.code is string && d.code.size() <= 8
        && (!('table' in d) || (d.table is string && d.table.size() <= 10))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    // Nombre del negocio, minutos por orden, etc.
    match /config/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Productos del menú
    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Pedidos completos (nombre, productos, total).
    // Un cliente solo puede leer SU pedido (necesita el código interno largo, imposible de adivinar).
    match /orders/{id} {
      allow get: if true;
      allow list, update, delete: if isOwner();
      allow create: if validOrder();
    }

    // Fila pública: solo hora y estado, sin nombres ni productos.
    // Sirve para que cada cliente vea cuántas personas tiene delante.
    match /queue/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'pendiente'
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(id));
      allow update, delete: if isOwner();
    }
  }
}
