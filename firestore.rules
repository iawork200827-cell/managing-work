rules_version = '2';

// Reglas de seguridad de la base de datos.
// - Clientes (sin cuenta): ven el menú, abren la cuenta de su mesa, envían pedidos
//   (mesa, para llevar o desde casa) y ven el estado de su pedido / de su mesa.
// - Empleados (QR de empleados + PIN): toman pedidos, abren y cobran cuentas, ven la cocina.
//   No ven ventas ni pedidos terminados, ni cambian productos o ajustes.
// - Encargado (QR de empleados + PIN de encargado): como el dueño, pero no cambia los PIN.
// - Dueño (correo y contraseña): todo lo anterior + productos, ajustes, ventas y anulaciones.
service cloud.firestore {
  match /databases/{database}/documents {

    // Correo(s) del dueño. Debe coincidir con OWNER_EMAILS en public/js/firebase-config.js
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['iawork200827@gmail.com'];
    }

    // Empleado: entró con el QR de empleados y el PIN vigente (si el dueño cambia el PIN, deja de valer)
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffSessions/$(request.auth.uid))
        && exists(/databases/$(database)/documents/staffConfig/main)
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.pin
           == get(/databases/$(database)/documents/staffConfig/main).data.pin;
    }
    // Encargado: entra con el QR de empleados + el PIN de encargado. Puede todo lo del dueño
    // salvo cambiar los PIN (en la app tampoco ve el total de ventas).
    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffSessions/$(request.auth.uid))
        && exists(/databases/$(database)/documents/staffConfig/main)
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.get('role', 'mesero') == 'encargado'
        && get(/databases/$(database)/documents/staffConfig/main).data.get('mgrPin', '') != ''
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.pin
           == get(/databases/$(database)/documents/staffConfig/main).data.mgrPin;
    }
    function isAdmin() { return isOwner() || isManager(); }
    function isTeam() { return isAdmin() || isStaff(); }

    function shop() {
      return get(/databases/$(database)/documents/config/shop).data;
    }

    // El dueño puede cerrar los pedidos del día: closedUntil = fin del día.
    function shopOpen() {
      return !exists(/databases/$(database)/documents/config/shop)
        || !('closedUntil' in shop())
        || shop().closedUntil == null
        || request.time > shop().closedUntil;
    }

    function validItems(items) {
      return items is list && items.size() > 0 && items.size() <= 60;
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'customer', 'phone', 'delivery', 'address', 'table', 'session', 'note',
                               'items', 'plates', 'total', 'minutes', 'status', 'createdAt', 'code', 'paid', 'takenBy',
                               'platform', 'extRef', 'discount', 'promos', 'zone', 'deliveryFee', 'scheduledFor'])
        && (!('zone' in d) || (d.zone is string && d.zone.size() <= 60))
        && (!('deliveryFee' in d) || (d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 1000))
        && (!('scheduledFor' in d) || (d.scheduledFor is string && d.scheduledFor.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && (!('discount' in d) || (d.discount is number && d.discount >= 0))
        && (!('promos' in d) || (d.promos is list && d.promos.size() <= 10))
        && (!('takenBy' in d) || (d.takenBy is string && d.takenBy.size() <= 40 && isTeam()))
        && d.paid == false
        && d.createdAt == request.time
        && validItems(d.items)
        && d.total is number && d.total >= 0
        && d.minutes is number && d.minutes >= 1 && d.minutes <= 60
        && d.code is string && d.code.size() <= 8
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && (!('plates' in d) || (d.plates is number && d.plates >= 1 && d.plates <= 20))
        && shopOpen()
        && (
          // Para llevar en el local: entra directo a cocina y se paga al recoger
          (d.type == 'llevar' && d.status == 'pendiente'
            && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 60
            && (('phone' in d && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20)
                || (isTeam() && !('phone' in d))))
          ||
          // Ronda de una mesa: el celular debe conocer la sesión secreta de una cuenta abierta
          // de esa mesa (la abrió con el QR o se unió con el código)
          (d.type == 'mesa' && d.status == 'pendiente'
            && d.table is string && d.table.size() <= 10
            && d.session is string
            && get(/databases/$(database)/documents/tabSecrets/$(d.session)).data.table == d.table
            && get(/databases/$(database)/documents/tabs/$(d.session)).data.closed == false)
          ||
          // Pedido de Uber Eats / DiDi Food: solo lo captura el equipo
          (d.type == 'plataforma' && d.status == 'pendiente' && isTeam()
            && d.platform in ['uber', 'didi']
            && d.extRef is string && d.extRef.size() <= 30
            && (!('customer' in d) || (d.customer is string && d.customer.size() <= 60)))
          ||
          // Pedido desde casa: queda "por pagar" hasta que el dueño confirma la transferencia
          (d.type == 'casa' && d.status == 'por_pagar'
            && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 60
            && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 20
            && (d.delivery == 'recoger'
                || (d.delivery == 'domicilio'
                    && d.address is string && d.address.size() >= 5 && d.address.size() <= 200
                    && !(exists(/databases/$(database)/documents/config/shop)
                         && shop().get('deliveryOn', true) == false))))
        );
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos (mesa, para llevar y desde casa).
    // - Cualquiera puede leer UN pedido si conoce su código interno (imposible de adivinar).
    // - Solo el dueño puede listarlos. La cuenta de cada mesa se ve en tabs/{sesión}/rounds.
    match /orders/{id} {
      allow get: if true;
      // Empleados: solo ven los pedidos en curso (no los terminados, así no ven lo que se va ganando)
      allow list: if isAdmin()
        || (isStaff() && resource.data.status in ['por_pagar', 'pendiente', 'preparando', 'listo']);
      allow create: if validOrder();
      allow update: if isAdmin()
        // Empleado: avanzar en cocina, cancelar, confirmar pago y cobrar
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'preparandoAt', 'listoAt', 'entregadoAt', 'confirmedAt', 'paid', 'payMethod', 'cancelledBy', 'handledBy'])
            && request.resource.data.status in ['pendiente', 'preparando', 'listo', 'entregado', 'cancelado'])
        // El cliente de casa avisa que ya transfirió (solo escribe su referencia)
        || (resource.data.type == 'casa' && resource.data.status == 'por_pagar'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payRef'])
            && request.resource.data.payRef is string
            && request.resource.data.payRef.size() >= 1 && request.resource.data.payRef.size() <= 60);
      allow delete: if isAdmin();
    }

    // Fila pública: solo hora, estado y minutos estimados. Sin nombres ni productos.
    match /queue/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['status', 'createdAt', 'minutes'])
        && request.resource.data.status == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.minutes is number
        && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 60
        // Solo pedidos que ya van a cocina (los de casa, hasta que se confirma el pago)
        && getAfter(/databases/$(database)/documents/orders/$(id)).data.status == 'pendiente';
      allow update, delete: if isTeam();
    }

    // ---------------- Mesas ----------------
    // tableKeys/{mesa}:   clave secreta que va en el QR impreso de cada mesa (solo el dueño la ve).
    // tabSecrets/{sesión}: prueba de que la cuenta se abrió con el QR de esa mesa (nadie la lee).
    // tabs/{sesión}:       la cuenta; solo la ve quien conoce la sesión. rounds/ = sus rondas.
    //                      Una mesa puede tener varias cuentas abiertas a la vez.
    // joins/{mesa}-{código}: permite a los demás unirse a una cuenta con el código de 6 letras.

    match /tableKeys/{table} {
      allow read, write: if isAdmin();
    }

    match /tabSecrets/{session} {
      allow read, update, delete: if isAdmin();
      // Abrir una cuenta: hay que tener la clave del QR de la mesa
      allow create: if isAdmin()
        || (session.size() >= 20 && session.size() <= 40
            && request.resource.data.keys().hasOnly(['table', 'key', 'openedAt'])
            && request.resource.data.table is string && request.resource.data.table.size() <= 10
            && request.resource.data.openedAt == request.time
            && shopOpen()
            && (
              // Cliente: con la clave del QR de la mesa
              (exists(/databases/$(database)/documents/tableKeys/$(request.resource.data.table))
                && request.resource.data.key == get(/databases/$(database)/documents/tableKeys/$(request.resource.data.table)).data.key)
              // Empleado: puede abrir cuentas en cualquier mesa
              || (request.resource.data.key == 'staff' && isStaff())
            ));
    }

    // Versión anterior (una cuenta por mesa). Solo lectura para clientes; el dueño las limpia.
    match /tableSecrets/{table} {
      allow read, write: if isAdmin();
    }
    match /tables/{table} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tabs/{session} {
      allow get: if true;
      allow list: if isTeam();
      allow create: if request.resource.data.keys().hasOnly(['table', 'openedAt', 'code', 'closed', 'billRequested', 'name', 'openedBy', 'phone'])
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('openedBy' in request.resource.data) || (request.resource.data.openedBy is string && request.resource.data.openedBy.size() <= 40))
        && request.resource.data.table is string
        && request.resource.data.openedAt == request.time
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.closed == false
        && request.resource.data.billRequested == false
        && getAfter(/databases/$(database)/documents/tabSecrets/$(session)).data.table == request.resource.data.table
        && getAfter(/databases/$(database)/documents/tabSecrets/$(session)).data.openedAt == request.time;
      allow update: if isAdmin()
        // Empleado: cobrar y cerrar la cuenta
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['closed', 'billRequested', 'total', 'payMethod', 'closedAt', 'closedBy', 'tip', 'tipBy', 'call']))
        // Llamar al mesero (cliente de la cuenta abierta)
        || (resource.data.closed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
            && request.resource.data.call.keys().hasOnly(['reason', 'at'])
            && request.resource.data.call.reason is string && request.resource.data.call.reason.size() <= 60
            && request.resource.data.call.at == request.time)
        // Pedir la cuenta
        || (resource.data.closed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billRequested'])
            && request.resource.data.billRequested == true);
      allow delete: if isAdmin();

      // Copia de cada ronda para que la mesa vea su cuenta
      match /rounds/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['items', 'total', 'status', 'createdAt', 'minutes', 'plates', 'discount'])
          && request.resource.data.status == 'pendiente'
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/orders/$(id)).data.session == session
          && getAfter(/databases/$(database)/documents/orders/$(id)).data.total == request.resource.data.total;
        allow update: if isTeam();
        allow delete: if isAdmin();
      }
    }

    // Código de mesa para que los demás se unan a la cuenta. Id: "{mesa}-{CÓDIGO}"
    match /joins/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['session', 'table', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && id.matches('^[0-9A-Za-z]{1,10}-[A-Z0-9]{6}$')
        && id.split('-')[0] == request.resource.data.table
        && getAfter(/databases/$(database)/documents/tabSecrets/$(request.resource.data.session)).data.table == request.resource.data.table;
      allow update, delete: if isAdmin();
    }

    // ---------------- Empleados ----------------
    // staffConfig/main: { pin, key } — solo el dueño. El QR de empleados lleva la key.
    match /staffConfig/{id} {
      allow read, write: if isOwner();
    }
    // staffSessions/{uid}: el empleado entra con el QR (key) + PIN. Si el dueño cambia el PIN, deja de valer.
    match /staffSessions/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'key', 'name', 'createdAt', 'role'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/staffConfig/main)
        && request.resource.data.key == get(/databases/$(database)/documents/staffConfig/main).data.key
        && (
          // Mesero
          (request.resource.data.get('role', 'mesero') == 'mesero'
            && request.resource.data.pin == get(/databases/$(database)/documents/staffConfig/main).data.pin)
          // Encargado (con su propio PIN)
          || (request.resource.data.get('role', 'mesero') == 'encargado'
            && get(/databases/$(database)/documents/staffConfig/main).data.get('mgrPin', '') != ''
            && request.resource.data.pin == get(/databases/$(database)/documents/staffConfig/main).data.mgrPin)
        );
      allow delete: if isOwner() || (request.auth != null && request.auth.uid == uid);
    }

    // ---------------- Facturas ----------------
    match /invoices/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['ref', 'kind', 'table', 'code', 'rfc', 'razon', 'email', 'cp', 'regimen', 'uso', 'total', 'createdAt', 'done'])
        && request.resource.data.kind in ['pedido', 'cuenta']
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && request.resource.data.rfc is string && request.resource.data.rfc.size() >= 12 && request.resource.data.rfc.size() <= 13
        && request.resource.data.razon is string && request.resource.data.razon.size() >= 1 && request.resource.data.razon.size() <= 150
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.cp is string && request.resource.data.cp.matches('^[0-9]{5}$')
        && request.resource.data.regimen is string && request.resource.data.regimen.size() <= 80
        && request.resource.data.uso is string && request.resource.data.uso.size() <= 80
        && request.resource.data.total is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.done == false;
    }

    // ---------------- Reseñas ----------------
    match /reviews/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['stars', 'comment', 'ref', 'kind', 'createdAt'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && request.resource.data.kind in ['pedido', 'cuenta']
        && request.resource.data.createdAt == request.time;
    }

    // ---------------- Cortes de caja (solo el dueño) ----------------
    match /cortes/{id} {
      allow read, write: if isOwner();
    }

    // ---------------- Lealtad (por teléfono) ----------------
    // El cliente ve su avance si conoce su número; solo el equipo suma o canjea visitas.
    match /loyalty/{phone} {
      allow get: if phone.matches('^[0-9]{10}$');
      allow list: if isAdmin();
      allow write: if isTeam() && phone.matches('^[0-9]{10}$');
    }
  }
}
